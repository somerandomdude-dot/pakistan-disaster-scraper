DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/disaster_alerts
ADMIN_API_KEY=change-me
APP_ENV=development
LOG_LEVEL=INFO
SCRAPER_USER_AGENT=PakistanDisasterAlertBot/1.0
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=3
ALLOWED_ORIGINS=["http://localhost:3000"]
HTTP_PROXY=

# Nearby-alert geolocation. Download GeoLite2 City from MaxMind and place it
# at app/data/GeoLite2-City.mmdb; the licensed database is intentionally ignored.
GEOIP_DATABASE_PATH=app/data/GeoLite2-City.mmdb
GEOIP_RELOAD_INTERVAL_SECONDS=3600

# Proxy headers are ignored unless both this flag is true and the immediate
# request peer belongs to one of these explicit IP/CIDR ranges.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=
LOCAL_DEVELOPMENT_IP=

DEFAULT_LOCATION_LAT=30.3753
DEFAULT_LOCATION_LNG=69.3451
DEFAULT_LOCATION_CITY=Pakistan Centre
DEFAULT_LOCATION_COUNTRY=Pakistan
DEFAULT_LOCATION_COUNTRY_CODE=PK
NEARBY_ALERT_DEFAULT_LIMIT=50
NEARBY_ALERT_MAX_LIMIT=200
NEARBY_ALERT_DEFAULT_RADIUS_KM=
NEARBY_ALERT_MAX_RADIUS_KM=5000
NEARBY_ALERT_FALLBACK_SCAN_LIMIT=2000
